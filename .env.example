# Copy to .env.local for development. Set the same keys in Vercel for production.

# Public site origin, used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL for large media (video loops, image sequences, GLB) on Vercel Blob or R2.
# Empty means media is served from /public.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Contact form delivery through Resend. Without these the form falls back to mailto.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Jev (TypeSafe) intent layer, server only. Without it the site skips intent features.
TYPESAFE_API_KEY=

# Privacy-friendly analytics. Leave empty to keep analytics off.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
